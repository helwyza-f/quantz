{
  "name": "quantz-monorepo",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": ".\\.venv\\Scripts\\python -m quantz.cli stack --reload-backend",
    "dev:bridge": ".\\.venv\\Scripts\\python -m quantz.cli stack --reload-backend --with-bridge",
    "backend:dev": "powershell -ExecutionPolicy Bypass -File scripts/dev-backend.ps1",
    "frontend:dev": "npm.cmd --prefix frontend run dev",
    "frontend:build": "npm.cmd --prefix frontend run build",
    "frontend:lint": "npm.cmd --prefix frontend run lint",
    "test": ".\\.venv\\Scripts\\python -m pytest"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
